# Copia este archivo a `.env.local` y completa los valores.
# Supabase: Dashboard → tu proyecto → Settings → API
#   - Project URL → NEXT_PUBLIC_SUPABASE_URL
#   - anon public → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - service_role (solo servidor; no expongas en el cliente) → SUPABASE_SERVICE_ROLE_KEY

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recomendado en producción y para scripts admin
SUPABASE_SERVICE_ROLE_KEY=

# Ver README.md para ERP_ORG_ID, ANTIFRAUD_ACCESS_CODE, etc.

# Sentry: Dashboard → tu proyecto → Settings → Client Keys (DSN)
# Si no se configura, la captura de errores se desactiva silenciosamente.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
